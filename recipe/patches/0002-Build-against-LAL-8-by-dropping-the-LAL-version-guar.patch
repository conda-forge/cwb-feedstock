From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Francesco Salemi <francesco.salemi@uniroma1.it>
Date: Fri, 27 Nov 2026 17:36:06 +0100
Subject: [PATCH] Build against LAL 8 by dropping the LAL version guards

Backport of the source part of gwburst/public/library!28 (30b512d0) to
cWB-6.4.8.0: remove the LAL_VERSION guards in tools/cwb/mdc.{cc,hh},
use XLALSimInspiralGetApproximantFromString, and check in CMake that
lal >= 7.3, lalmetaio >= 4.0 and lalburst >= 2.0 are found.
---
 CMakeLists.txt   |  30 ++++++++
 tools/cwb/mdc.cc | 184 +----------------------------------------------
 tools/cwb/mdc.hh |  21 ------
 3 files changed, 32 insertions(+), 203 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8ee58b4e..5935182b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -97,6 +97,36 @@ endif()
 #Find LAL
 pkg_check_modules(LAL IMPORTED_TARGET "lal lalburst lalmetaio lalsimulation")
 if(${LAL_FOUND})
+     # mdc reads the sim_inspiral and sim_burst tables with the LIGO_LW API of
+     # lalmetaio >= 4.0 (LIGOLwXMLRead.h: XLALSimInspiralTableFromLIGOLw and
+     # XLALSimBurstTableFromLIGOLw without a time range), which replaced the readers of
+     # lalburst < 2.0 and lalinspiral; all of them came with lal 7.3 in lalsuite 7.13.
+     # Fail here rather than inside rootcling. The versions are not put in
+     # pkg_check_modules: an older LAL would then be "not found" and cWB would silently
+     # build without LAL. The modules are passed as one string, so no per-module
+     # version variable is set: query each one on its own.
+     set(CWB_LAL_MIN_VERSIONS lal 7.3 lalmetaio 4.0 lalburst 2.0)
+     set(CWB_LAL_TOO_OLD "")
+     set(CWB_LAL_FOUND_VERSIONS "")
+     list(LENGTH CWB_LAL_MIN_VERSIONS _n)
+     math(EXPR _last "${_n} - 1")
+     foreach(_i RANGE 0 ${_last} 2)
+          math(EXPR _j "${_i} + 1")
+          list(GET CWB_LAL_MIN_VERSIONS ${_i} _mod)
+          list(GET CWB_LAL_MIN_VERSIONS ${_j} _min)
+          pkg_check_modules(CWB_LALMOD_${_mod} QUIET ${_mod})
+          set(_ver "${CWB_LALMOD_${_mod}_VERSION}")
+          list(APPEND CWB_LAL_FOUND_VERSIONS "${_mod} ${_ver}")
+          if(_ver VERSION_LESS _min)
+               list(APPEND CWB_LAL_TOO_OLD "${_mod} ${_ver} (needs >= ${_min})")
+          endif()
+     endforeach()
+     if(CWB_LAL_TOO_OLD)
+          string(REPLACE ";" ", " _msg "${CWB_LAL_TOO_OLD}")
+          message(FATAL_ERROR "cWB needs lalsuite >= 7.13 (lal 7.3, lalmetaio 4.0, lalburst 2.0); too old: ${_msg}")
+     endif()
+     string(REPLACE ";" ", " _msg "${CWB_LAL_FOUND_VERSIONS}")
+     message(STATUS "LAL versions: ${_msg}")
      list(APPEND CWB_OPTS _USE_LAL)
 endif()
 
