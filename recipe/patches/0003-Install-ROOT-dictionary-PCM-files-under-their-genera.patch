From e44f6edc2c244a8533c4e9c248c2ee96f07312e7 Mon Sep 17 00:00:00 2001
From: Duncan Macleod <macleoddm@cardiff.ac.uk>
Date: Tue, 17 Nov 2026 11:08:15 +0000
Subject: [PATCH 3/3] Install ROOT dictionary PCM files under their generated
 names

Since ROOT 6.40, ROOT_GENERATE_DICTIONARY(... MODULE <target>) names the
generated _rdict.pcm file after the target's OUTPUT_NAME property rather
than the target name itself, e.g. libwavelet-4x_rdict.pcm rather than
libWAT_rdict.pcm. The install rules hard-coded the old name, so
`cmake --install` failed looking for a file that was never generated.

Use a generator expression to derive the name from OUTPUT_NAME so that
the install rules match what ROOT generates.
---
 tools/bico/CMakeLists.txt      | 2 +-
 tools/cwb/CMakeLists.txt       | 2 +-
 tools/frame/CMakeLists.txt     | 2 +-
 tools/gwat/CMakeLists.txt      | 2 +-
 tools/history/CMakeLists.txt   | 2 +-
 tools/stft/CMakeLists.txt      | 2 +-
 tools/toolbox/CMakeLists.txt   | 2 +-
 tools/wavegraph/CMakeLists.txt | 2 +-
 tools/xhtml/CMakeLists.txt     | 2 +-
 wat/CMakeLists.txt             | 2 +-
 10 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/tools/bico/CMakeLists.txt b/tools/bico/CMakeLists.txt
index 47937d5a..1824daf2 100644
--- a/tools/bico/CMakeLists.txt
+++ b/tools/bico/CMakeLists.txt
@@ -47,5 +47,5 @@ ROOT_GENERATE_DICTIONARY(Bicoherence_dict ${BICO_HDRS}
 install(TARGETS ${PROJECT_NAME})
 install(FILES ${BICO_HDRS}
         TYPE INCLUDE)
-install(FILES ${CMAKE_CURRENT_BINARY_DIR}/${CMAKE_SHARED_LIBRARY_PREFIX}${PROJECT_NAME}_rdict.pcm
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/${CMAKE_SHARED_LIBRARY_PREFIX}$<TARGET_PROPERTY:${PROJECT_NAME},OUTPUT_NAME>_rdict.pcm
         TYPE LIB)
