-#if (LAL_VERSION_MAJOR == 7 && LAL_VERSION_MINOR < 3) || \
-    LAL_VERSION_MAJOR < 7
+#if !CWB_LAL_VERSION_GE(7, 3, 0, 0)
   INT4 numInjections = 0;
 #endif
   SimInspiralTable *injections = NULL;
@@ -5187,7 +5180,7 @@ CWB::mdc::GetInspiral(wavearray<double>& x, TString ifo) {
 
   XLALSetSilentErrorHandler();
 
-#if LAL_VERSION_MAJOR >= 7 && LAL_VERSION_MINOR >= 3
