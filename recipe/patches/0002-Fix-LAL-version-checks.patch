   for (thisInj = injections; thisInj; thisInj = thisInj->next)
   {                                                           
-#if LAL_VERSION_MAJOR >= 7 && LAL_VERSION_MINOR >= 3
+#if CWB_LAL_VERSION_GE(7, 3, 0, 0)
     int epoch = thisInj->geocent_end_time.gpsSeconds;
     if(epoch<gpsStartSec || epoch>gpsEndSec) continue;	// skip events outside the buffer range
 #endif
@@ -5878,7 +5871,7 @@ CWB::mdc::FindChirpInjectSignals(wavearray<double>& w, SimInspiralTable *injecti
   SimInspiralTable *thisInj = NULL;
   for (thisInj = injections; thisInj; thisInj = thisInj->next)
   {                                                       
-#if LAL_VERSION_MAJOR >= 7 && LAL_VERSION_MINOR >= 3
+#if CWB_LAL_VERSION_GE(7, 3, 0, 0)
     int epoch = thisInj->geocent_end_time.gpsSeconds;
     if(epoch<gpsStartSec || epoch>gpsEndSec) continue;	// skip events outside the buffer range
 #endif
