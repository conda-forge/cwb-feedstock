     }
 
     // read sim_burst table from XML file (see LIGOLwXMLBurstRead.c)
-#if LAL_VERSION_MAJOR >= 7 && LAL_VERSION_MINOR >= 3
+#if CWB_LAL_VERSION_GE(7, 3, 0, 0)
     SimBurst* sim_burst = XLALSimBurstTableFromLIGOLw(fName.Data());
 #else
     LIGOTimeGPS gpsStartTime = {(int)start, 0};
@@ -5175,8 +5169,7 @@ CWB::mdc::GetInspiral(wavearray<double>& x, TString ifo) {
   wat::Time inj_time_shift(inj_shift);
 
