-   (LAL_VERSION_MICRO >  0 || (LAL_VERSION_MICRO ==  0 && LAL_VERSION_DEVEL >= 1)))))     // LAL_VERSION >= 6.18.0.1
+#if CWB_LAL_VERSION_GE(6, 18, 0, 1)     // LAL_VERSION >= 6.18.0.1
 
       // see LALInferenceReadData.c
       LALDict *LALpars=XLALCreateDict();
@@ -5979,9 +5970,7 @@ CWB::mdc::FindChirpInjectSignals(wavearray<double>& w, SimInspiralTable *injecti
 
     } else {
 
-#if LAL_VERSION_MAJOR >   6 || (LAL_VERSION_MAJOR ==  6 && \
-   (LAL_VERSION_MINOR >  16 || (LAL_VERSION_MINOR == 16 && \
-    LAL_VERSION_MICRO >=  1                             )))     // LAL_VERSION >= 6.16.1
+#if CWB_LAL_VERSION_GE(6, 16, 1, 0)     // LAL_VERSION >= 6.16.1
 
       // check if source is produced by CWB::mdc::Posterior2XML
       TString source = TString(thisInj->source);
@@ -6138,8 +6127,7 @@ CWB::mdc::GetInspiral(TString pol, int gps_start_time, int gps_end_time) {
   wat::Time inj_time_shift(inj_shift);
 
   // injections 
-#if (LAL_VERSION_MAJOR == 7 && LAL_VERSION_MINOR < 3) || \
-    LAL_VERSION_MAJOR < 7
+#if !CWB_LAL_VERSION_GE(7, 3, 0, 0)
   INT4 numInjections = 0;
 #endif
   SimInspiralTable *injections = NULL;
@@ -6150,7 +6138,7 @@ CWB::mdc::GetInspiral(TString pol, int gps_start_time, int gps_end_time) {
 
