From e5f3bd23406eff1e5162bd61c68616fb179a42da Mon Sep 17 00:00:00 2001
From: Duncan Macleod <macleoddm@cardiff.ac.uk>
Date: Tue, 17 Nov 2026 10:36:35 +0000
Subject: [PATCH 2/3] Fix LAL version checks

Use a macro to generate the LAL_VERSION as a single integer, so that we can compare minor versions properly
---
 tools/cwb/mdc.cc | 50 ++++++++++++++++--------------------------------
 tools/cwb/mdc.hh | 26 +++++++++++++------------
 2 files changed, 31 insertions(+), 45 deletions(-)

diff --git a/tools/cwb/mdc.cc b/tools/cwb/mdc.cc
index 4100f156..78be793a 100644
--- a/tools/cwb/mdc.cc
+++ b/tools/cwb/mdc.cc
@@ -778,9 +778,7 @@ CWB::mdc::AddWaveform(MDC_TYPE mdc_type, vector<mdcpar> par, TString uname) {
