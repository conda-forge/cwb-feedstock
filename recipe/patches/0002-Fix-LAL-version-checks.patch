diff --git a/tools/cwb/mdc.hh b/tools/cwb/mdc.hh
index f957b18b..f042845d 100644
--- a/tools/cwb/mdc.hh
+++ b/tools/cwb/mdc.hh
@@ -84,12 +84,21 @@
 #undef _RANDOM_H        
 #endif
 
-#if LAL_VERSION_MAJOR >= 7 && LAL_VERSION_MINOR >= 3
+#include <lal/LALConfig.h>
+
+#define CWB_LAL_VERSION_ENCODE(major, minor, micro, devel) \
+  ((major) * 1000000000LL + (minor) * 1000000LL + (micro) * 1000LL + (devel))
+#define CWB_LAL_VERSION \
+  CWB_LAL_VERSION_ENCODE(LAL_VERSION_MAJOR, LAL_VERSION_MINOR, \
+                         LAL_VERSION_MICRO, LAL_VERSION_DEVEL)
+#define CWB_LAL_VERSION_GE(major, minor, micro, devel) \
+  (CWB_LAL_VERSION >= CWB_LAL_VERSION_ENCODE(major, minor, micro, devel))
+
+#if CWB_LAL_VERSION_GE(7, 3, 0, 0)
 #include <lal/LIGOLwXMLRead.h>
 #else
 #include <lal/LIGOLwXMLInspiralRead.h>
 #endif
-#include <lal/LALConfig.h>
 #include <lal/LALStdio.h>
 #include <lal/LALStdlib.h>
 #include <lal/LALError.h>
@@ -112,24 +121,17 @@
 #include <lal/LALStatusMacros.h>
 #include <lal/LALSimulation.h>
 #include <lal/LALSimIMR.h>
-#if LAL_VERSION_MAJOR >   6 || (LAL_VERSION_MAJOR ==  6 && \
-   (LAL_VERSION_MINOR >  14 || (LAL_VERSION_MINOR == 14 && \
-    LAL_VERSION_MICRO >=  0                             ))) 	// LAL_VERSION >= 6.14.0
+#if CWB_LAL_VERSION_GE(6, 14, 0, 0)
 #include <lal/SnglBurstUtils.h>
 #else
 #include <lal/LIGOMetadataBurstUtils.h>
 #endif
-#if (LAL_VERSION_MAJOR == 7 && LAL_VERSION_MINOR < 3) || \
-    LAL_VERSION_MAJOR < 7
+#if !CWB_LAL_VERSION_GE(7, 3, 0, 0)
 #include <lal/LIGOLwXMLBurstRead.h>
 #endif
 #include <lal/GenerateBurst.h>
 #include <lal/LIGOLwXML.h>
-#if (LAL_VERSION_MAJOR >   6 || (LAL_VERSION_MAJOR ==  6 && \
-   (LAL_VERSION_MINOR >  19 || (LAL_VERSION_MINOR == 19 && \
-    LAL_VERSION_MICRO >=  2 )))) && \
-  ((LAL_VERSION_MAJOR == 7 && LAL_VERSION_MINOR < 3) || \
-    LAL_VERSION_MAJOR < 7)
+#if CWB_LAL_VERSION_GE(6, 19, 2, 0) && !CWB_LAL_VERSION_GE(7, 3, 0, 0)
 #include <lal/LIGOLwXMLlegacy.h>
 #endif
 
