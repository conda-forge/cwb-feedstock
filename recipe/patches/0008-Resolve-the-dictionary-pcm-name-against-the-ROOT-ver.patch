From 29cb231a772ddba02e588552c5ad2c2fc5173b09 Mon Sep 17 00:00:00 2001
From: Chris Burr <christopher.burr@cern.ch>
Date: Sun, 20 Sep 2026 22:00:01 +0200
Subject: [PATCH] Resolve the dictionary pcm name against the ROOT version

ROOT 6.40 changed how rootcling names the generated dictionary pcm. Up to
6.38 it was derived from the CMake target name:

    set(pcm_name .../${libprefix}${library_target_name}_rdict.pcm)

and from 6.40 it follows the target's OUTPUT_NAME instead:

    get_target_property(library_output_name ${library_target_name} OUTPUT_NAME)
    set(pcm_name .../${libprefix}${library_output_name}_rdict.pcm)

Eight of the nine dictionary libraries here set an OUTPUT_NAME that differs
from the target, so their pcm moved: libWAT_rdict.pcm became
libwavelet-4x_rdict.pcm, libBICO_rdict.pcm became libBicoherence_rdict.pcm, and
so on. The install rules still ask for the old name, so the build fails at
install time against ROOT 6.40:

    CMake Error at wat/cmake_install.cmake:95 (file):
      file INSTALL cannot find ".../build/wat/libWAT_rdict.pcm":
      No such file or directory.

wat is simply the first one install reaches. Only tools/stft is unaffected,
because its target and OUTPUT_NAME happen to match.

root_rdict_pcm() picks whichever name applies, so the tree keeps building on
6.36 and 6.38 as well as 6.40. It falls back to the target name when no
OUTPUT_NAME is set, which is also what ROOT does.
---
 cmake/install_function.cmake   | 18 ++++++++++++++++++
 tools/bico/CMakeLists.txt      |  3 ++-
 tools/cwb/CMakeLists.txt       |  3 ++-
 tools/frame/CMakeLists.txt     |  3 ++-
 tools/gwat/CMakeLists.txt      |  3 ++-
 tools/history/CMakeLists.txt   |  3 ++-
 tools/stft/CMakeLists.txt      |  3 ++-
 tools/toolbox/CMakeLists.txt   |  3 ++-
 tools/wavegraph/CMakeLists.txt |  3 ++-
 wat/CMakeLists.txt             |  3 ++-
 10 files changed, 36 insertions(+), 9 deletions(-)

diff --git a/cmake/install_function.cmake b/cmake/install_function.cmake
index bd72cd8..d074c3e 100644
--- a/cmake/install_function.cmake
+++ b/cmake/install_function.cmake
@@ -33,3 +33,21 @@ function (install_files)
         install (FILES ${ARGV} DESTINATION bin)
     endif ()
 endfunction ()
+
+# ROOT >= 6.40 names the rootcling dictionary pcm after the library's
+# OUTPUT_NAME; before that it used the CMake target name. Every library here
+# that sets an OUTPUT_NAME differing from its target therefore moved, e.g.
+# libWAT_rdict.pcm -> libwavelet-4x_rdict.pcm. Resolve whichever name applies
+# for <target> into <outvar>.
+function (root_rdict_pcm target outvar)
+    set (basename ${target})
+    if (NOT ROOT_VERSION VERSION_LESS 6.40)
+        get_target_property (output_name ${target} OUTPUT_NAME)
+        if (output_name)
+            set (basename ${output_name})
+        endif ()
+    endif ()
+    set (${outvar}
+         ${CMAKE_CURRENT_BINARY_DIR}/${CMAKE_SHARED_LIBRARY_PREFIX}${basename}_rdict.pcm
+         PARENT_SCOPE)
+endfunction ()
diff --git a/tools/bico/CMakeLists.txt b/tools/bico/CMakeLists.txt
index 47937d5..ef3e9af 100644
--- a/tools/bico/CMakeLists.txt
+++ b/tools/bico/CMakeLists.txt
@@ -47,5 +47,6 @@ ROOT_GENERATE_DICTIONARY(Bicoherence_dict ${BICO_HDRS}
 install(TARGETS ${PROJECT_NAME})
 install(FILES ${BICO_HDRS}
         TYPE INCLUDE)
-install(FILES ${CMAKE_CURRENT_BINARY_DIR}/${CMAKE_SHARED_LIBRARY_PREFIX}${PROJECT_NAME}_rdict.pcm
+root_rdict_pcm(${PROJECT_NAME} RDICT_PCM)
+install(FILES ${RDICT_PCM}
         TYPE LIB)
